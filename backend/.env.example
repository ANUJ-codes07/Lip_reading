# Backend Server Configuration
HOST=127.0.0.1
PORT=8000

# Allowed CORS Origin for Local Frontend Development
ALLOWED_ORIGIN=http://localhost:5173

# External Visual Speech Recognition (Auto-AVSR Inference Endpoint)
# Set this to a functioning endpoint (e.g. your duplicated Space or local worker)
# Example: https://<your-username>-lip-reading.hf.space/predict or http://127.0.0.1:7860/predict
VSR_API_URL=

# Optional: Bearer token or API key if your external service requires authentication
VSR_API_KEY=
