# ==============================================================================
# LIP READING ENGINE CONFIGURATION
# To switch between modes, comment/uncomment the corresponding VSR_API_URL:
# ==============================================================================

# MODE 1: GOOGLE COLAB (CLOUD GPU)
# Run colab_chaplin_server.py in Google Colab and paste the generated trycloudflare URL below:
#RECOGNITION_MODE=colab
#VSR_API_URL=https://smooth-looks-ears-announces.trycloudflare.com/predict

# MODE 2: LOCAL RTX 5050 GPU (ON-DEVICE)
# Run `python local_chaplin_server.py` in your local terminal and uncomment below:
RECOGNITION_MODE=local
VSR_API_URL=http://127.0.0.1:8001/predict